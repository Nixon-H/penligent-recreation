{
  "name": "penligent-recreation",
  "version": "2.1.6",
  "private": true,
  "description": "Penligent - Penetration Testing Platform",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "electron:dev": "vite --host 127.0.0.1 --port 5173",
    "test": "node --test test/theme.test.cjs test/ipc.test.cjs test/orchestration.test.mjs test/features.test.mjs test/stores.test.mjs test/parity.test.mjs",
    "test:e2e": "node test/e2e/compare.cjs",
    "test:db": "electron test/db.test.cjs",
    "test:all": "npm test && npm run test:db && npm run test:functional && npm run test:regressions",
    "test:functional": "node test/e2e/functional.cjs",
    "test:ai": "node test/e2e/ai-provider.cjs",
    "mock-provider": "node test/e2e/mock-provider.cjs",
    "test:ai-ui": "node test/e2e/ai-ui.cjs",
    "test:regressions": "node test/e2e/regressions.cjs",
    "test:scanner": "node test/e2e/scanner.cjs",
    "test:proxy": "node test/e2e/proxy.cjs",
    "test:report": "node test/e2e/report.cjs",
    "audit": "node scripts/build-reference-usage.mjs"
  },
  "dependencies": {
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "better-sqlite3": "^12.4.1",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^0.552.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "mockttp": "^4.2.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.23",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "vite": "^7.2.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  },
  "productName": "Penligent-Recreation",
  "homepage": "https://penligent.ai/",
  "author": {
    "name": "Future Share LLC",
    "email": "penligent.ai"
  },
  "build": {
    "appId": "ai.penligent.recreation",
    "artifactName": "penligent-recreation_${version}_${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/depency",
        "to": "depency"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "penligent-recreation",
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "penligent.ai",
      "depends": [
        "libappindicator3-1",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgtk-3-0"
      ]
    }
  }
}
